# SynPassport Environment Configuration Template
# LLM used by the repair agent. Leave empty to use the built-in deterministic mock.
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Where runs, evidence and the server signing keypair (DATA_DIR/keys) are stored.
DATA_DIR=./data

# 1 = reuse cached runs from ./replay when the same dataset + mission is submitted.
SYNPASSPORT_REPLAY=0

# Optional: require this shared secret (X-Approver-Token header) to approve releases.
# Set it whenever the API is reachable by anyone other than you.
SYNPASSPORT_APPROVER_TOKEN=

# Trusted public key used by `passport verify` / the SDK when --public-key is not given.
# SYNPASSPORT_PUBLIC_KEY=./data/keys/api_public.pem

# Extra allowed browser origins for the API (comma separated).
# CORS_ORIGINS=http://localhost:3000
